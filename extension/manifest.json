{
  "manifest_version": 3,
  "name": "Gmail Memory Assistant",
  "version": "0.1.0",
  "description": "Draft Gmail replies that remember your preferences, using a local backend.",
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
